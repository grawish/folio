# Check out text files with LF everywhere. Folio hashes shipped sources,
# notices and templates, so Windows CRLF conversion would change their bytes.
* text=auto eol=lf

# Preserve original upstream notice bytes, including their line endings.
resources/tex-font-notices/* -text
resources/tex-resource-notices/* -text

# Preserve publisher license bytes, including their original final blank lines.
resources/npm-notices/* -text
resources/npm-notices/*LICENSE* -whitespace

# Preserve original PDF.js license and copyright-header bytes.
resources/pdfjs-notices/* -text -whitespace
